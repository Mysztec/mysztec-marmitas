# Supabase -- Project Settings > API Keys
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave publica do projeto. Aceita tanto o formato novo (sb_publishable_...)
# quanto a chave anon legada (eyJhbGciOi...). E publica por design: quem protege
# os dados sao as policies de RLS, nao o segredo da chave.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Dominio sintetico usado para transformar "usuario" em e-mail interno do
# Supabase Auth. Nao precisa ser real -- nenhum e-mail e enviado.
VITE_AUTH_EMAIL_DOMAIN=mysztec.local
